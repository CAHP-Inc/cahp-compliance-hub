    },
    "grossRentDefinition": "Gross rent includes contract rent PLUS any tenant-paid utility allowance. Published figures are MAXIMUM allowable gross rents by bedroom size.",
    "tierDerivation": {
      "50": "Published SC Housing Trust Fund 50% rent limits (= HUD MTSP 50%).",
      "60": "DERIVED in code as floor(1.2 x 50% limit). HUD MTSP 60% income limit = 1.2 x the 50% income limit; since gross rent = 30% of imputed income, the 60% rent ceiling = 1.2 x the 50% rent ceiling. Not separately published in the SCHTF tables; verify against the HUD MTSP 60% rent chart before filing if a unit's qualification turns on the 60% tier.",
      "80": "Published SC Housing Trust Fund 80% rent limits (= 30% of the HUD FY2026 80% / low-income limit at imputed household size)."
    },
    "imputedHousehold": "Bedroom-based imputed household of 1.5 persons per bedroom is already embodied in these published by-bedroom rent ceilings; no further imputation is applied by the generator.",
    "VERIFY_BEFORE_FILING": "These numbers were transcribed from the SC Housing FY2026 PDFs on 2026-06-11. Re-confirm against the live source PDFs (and the HUD MTSP 60% chart) before any letter is signed under penalty of perjury."
