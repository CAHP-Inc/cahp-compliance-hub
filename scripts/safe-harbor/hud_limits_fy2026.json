    "effectiveDate": "2026-05-01",
    "source": "South Carolina State Housing Finance & Development Authority (SC Housing) Trust Fund Rent Limits, derived from HUD FY2026 MTSP Income Limits (released 2026-05-01).",
    "sourceUrls": {
      "schousingIndex": "https://schousing.sc.gov/development/income-rent-limits",
