# =============================================================================
# CAHP Compliance Hub — Environment Configuration
# =============================================================================
# Copy this file to `.env.local` and fill in the values.
# .env.local is gitignored — never commit secrets.
# =============================================================================

# Base path for GitHub Pages deployment.
# Set to '/cahp-compliance-hub/' (or whatever your repo is called).
# Leave as '/' for local dev or if using a custom domain.
VITE_BASE_PATH=/

# -----------------------------------------------------------------------------
# Azure AD / MSAL — REQUIRED starting PR-02
# -----------------------------------------------------------------------------
# Get these from the Azure Portal after registering an app:
#   Azure Portal → Microsoft Entra ID → App registrations → New registration
#   - Name: CAHP Compliance Hub
#   - Supported account types: Single tenant
#   - Redirect URI: SPA → http://localhost:5173 (add prod URL later)
# After registering, copy the values below from the Overview page.
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# -----------------------------------------------------------------------------
# SharePoint — REQUIRED starting PR-03
# -----------------------------------------------------------------------------
# The SharePoint site that hosts the CAHP Compliance Hub Lists.
# Example: newshirepm.sharepoint.com:/sites/CAHPHub
VITE_SHAREPOINT_SITE=newshirepm.sharepoint.com:/sites/CAHPHub
